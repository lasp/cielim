#include "/Engine/Public/Platform.ush"

Texture2D InputTexture;
SamplerState InputSampler;

float SolidAngle; // This is in steradians
float PixelArea; // This is in m^2
float ExposureTime; // This is in seconds
float Transmission1; // dimensionless (0 to 1)
float Transmission2; // dimensionless (0 to 1)
float Transmission3; // dimensionless (0 to 1)
float W1EnergyInverse; // These are in 1/J
float W2EnergyInverse;
float W3EnergyInverse;
float4 QuECurveR;
float4 QuECurveG;
float4 QuECurveB;
float SimpsonFactor;
float CorrectionFactor;
uint CurrentTime;
uint EnableShotNoise; // 0 or 1
float DarkCurrent; // electrons / second
float DarkCurrentLogSigma;
float InvFullWellCapacity; // This is in # of electrons (inverse)

// RNG is a version of the process described in:
// https://developer.nvidia.com/gpugems/gpugems3/part-vi-gpu-computing/chapter-37-efficient-random-number-generation-and-application

// https://www.reedbeta.com/blog/hash-functions-for-gpu-rendering/
uint PcgHash(uint Input)
{
	uint State = Input * 747796405u + 2891336453u;
	uint Word = (State >> ((State >> 28u) + 4u) ^ State) * 277803737u;
	return (Word >> 22u) ^ Word;
}

uint CombinedTausworthe(inout uint Z, int S1, int S2, int S3, uint M)
{
	uint b = (Z << S1 ^ Z) >> S2;
	return Z = (Z & M) << S3 ^ b;
}

float UniformRNG(uint Z1, uint Z2, uint Z3, inout uint Z4)
{
	uint Step1 = CombinedTausworthe(Z1, 13, 19, 12, 4294967294u);
	uint Step2 = CombinedTausworthe(Z2, 2, 25, 4, 4294967288u);
	uint Step3 = CombinedTausworthe(Z3, 3, 11, 17, 4294967280u);
	Z4 = Z4 * 1664525 + 1013904223u;
	return 2.3283064365387e-10 * float(Step1 ^ Step2 ^ Step3 ^ Z4);
}

float2 BoxMuller(float U1, float U2)
{
	U1 = max(U1, 1e-6);
	float R = sqrt(-2 * log(U1));
	float Theta = 6.28318 * U2;
	return float2(R * sin(Theta), R * cos(Theta));
}

float4 ComputeRandGaussians(uint Seed)
{
	uint Z1 = PcgHash(Seed + 1);
	uint Z2 = PcgHash(Seed + 2);
	uint Z3 = PcgHash(Seed + 3);
	uint Z4 = PcgHash(Seed + 4);

	float U1 = UniformRNG(Z1, Z2, Z3, Z4);
	float U2 = UniformRNG(Z2, Z4, Z3, Z1);
	float U3 = UniformRNG(Z3, Z1, Z2, Z4);
	float U4 = UniformRNG(Z4, Z3, Z1, Z2);

	float2 RandGaussian1 = BoxMuller(U1, U2);
	float2 RandGaussian2 = BoxMuller(U3, U4);

	return float4(RandGaussian1.x, RandGaussian1.y, RandGaussian2.x, RandGaussian2.y);
}

float4 MainPS(float4 UV : TEXCOORD0, float4 Position : SV_Position) : SV_Target0
{
	// This is in W/m^2/nm/str
	float4 TotalRadiance = InputTexture.Sample(InputSampler, UV.xy);

	float W1Power	= SolidAngle * PixelArea * Transmission1 * TotalRadiance.r;		// Power values are in W/nm
	float W2Power	= SolidAngle * PixelArea * Transmission2 * TotalRadiance.g;
	float W3Power	= SolidAngle * PixelArea * Transmission3 * TotalRadiance.b;

	float NumW1ElectronsR = W1Power * W1EnergyInverse * ExposureTime * QuECurveR.r;
	float NumW2ElectronsR = W2Power * W2EnergyInverse * ExposureTime * QuECurveR.g;
	float NumW3ElectronsR = W3Power * W3EnergyInverse * ExposureTime * QuECurveR.b;

	float NumW1ElectronsG = W1Power * W1EnergyInverse * ExposureTime * QuECurveG.r;
	float NumW2ElectronsG = W2Power * W2EnergyInverse * ExposureTime * QuECurveG.g;
	float NumW3ElectronsG = W3Power * W3EnergyInverse * ExposureTime * QuECurveG.b;

	float NumW1ElectronsB = W1Power * W1EnergyInverse * ExposureTime * QuECurveB.r;
	float NumW2ElectronsB = W2Power * W2EnergyInverse * ExposureTime * QuECurveB.g;
	float NumW3ElectronsB = W3Power * W3EnergyInverse * ExposureTime * QuECurveB.b;

	/* Approximate integration over visible spectrum using R, G, and B channels and Simpson's 1/3 rule.
	 * This is a close approximation given the QE curve shape is roughly parabolic. */
	float NumElectronsR = SimpsonFactor * (NumW1ElectronsR + 4.0f * NumW2ElectronsR + NumW3ElectronsR);
	float NumElectronsG = SimpsonFactor * (NumW1ElectronsG + 4.0f * NumW2ElectronsG + NumW3ElectronsG);
	float NumElectronsB = SimpsonFactor * (NumW1ElectronsB + 4.0f * NumW2ElectronsB + NumW3ElectronsB);

	NumElectronsR *= CorrectionFactor;
	NumElectronsG *= CorrectionFactor;
	NumElectronsB *= CorrectionFactor;

	/* Here, we add photon shot noise, dark current, and dark shot noise to the image.
	 * All of these effects can only add electrons, not subtract. */

	uint Seed1 = (uint(Position.x) * 1973u) ^ (uint(Position.y) * 9277u) ^ (CurrentTime * 2663u);
	uint Seed2 = (uint(Position.x) * 6158u) ^ (uint(Position.y) * 4986u) ^ (CurrentTime * 1654u);
	uint Seed3 = (uint(Position.x) * 2347u) ^ (uint(Position.y) * 8946u) ^ (CurrentTime * 3756u);

	float4 RandGaussians = max(ComputeRandGaussians(Seed1), 0);

	float PhotonShotNoiseR = EnableShotNoise * RandGaussians.x * sqrt(NumElectronsR);
	float PhotonShotNoiseG = EnableShotNoise * RandGaussians.y * sqrt(NumElectronsG);
	float PhotonShotNoiseB = EnableShotNoise * RandGaussians.z * sqrt(NumElectronsB);

	// We model dark current as log-normal distribution with median=DarkCurrent and sigma=DarkCurrentStdDeviation

	RandGaussians = ComputeRandGaussians(Seed2);

	float TotalDarkRateR = DarkCurrent * exp(RandGaussians.x * DarkCurrentLogSigma);
	float DarkElectronsR = TotalDarkRateR * ExposureTime;

	float TotalDarkRateG = DarkCurrent * exp(RandGaussians.y * DarkCurrentLogSigma);
	float DarkElectronsG = TotalDarkRateG * ExposureTime;

	float TotalDarkRateB = DarkCurrent * exp(RandGaussians.z * DarkCurrentLogSigma);
	float DarkElectronsB = TotalDarkRateB * ExposureTime;

	RandGaussians = max(ComputeRandGaussians(Seed3), 0);

	float DarkShotNoiseR = EnableShotNoise * RandGaussians.x * sqrt(DarkElectronsR);
	float DarkShotNoiseG = EnableShotNoise * RandGaussians.y * sqrt(DarkElectronsG);
	float DarkShotNoiseB = EnableShotNoise * RandGaussians.z * sqrt(DarkElectronsB);

	NumElectronsR += PhotonShotNoiseR + DarkElectronsR + DarkShotNoiseR;
	NumElectronsG += PhotonShotNoiseG + DarkElectronsG + DarkShotNoiseG;
	NumElectronsB += PhotonShotNoiseB + DarkElectronsB + DarkShotNoiseB;

	// Set final output color to NumElectrons / FWC clamped to [0-1]

	float3 Color = saturate(float3(NumElectronsR, NumElectronsG, NumElectronsB) * InvFullWellCapacity);

	return float4(Color, TotalRadiance.a);
}
